{
  "name": "insightra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node scripts/api.mjs",
    "dev:all": "concurrently -k -n web,api \"npm:dev\" \"npm:dev:api\"",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:api": "node scripts/api.mjs --test",
    "format": "prettier --write src tests *.ts *.json *.js scripts/*.mjs docs/*.md README.md AGENTS.md",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
